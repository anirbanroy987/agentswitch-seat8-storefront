# Copy to .env (gitignored) and fill in.

# ─── Model ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── AgentSwitch (Team 08 · Storefront) ───────────────────────────────────
# The password is never stored here: `uv run python -m seat8 login --biz in`
# prompts for it and caches a bearer token in .secrets/ (gitignored).
AS_EMAIL=team08@theschoolofai.in
AS_URL_IN=https://agentswitch.theschoolofai.in
AS_URL_US=https://class.agentswitch.theschoolofai.in
AS_BIZ=in

# Optional, for non-interactive login (CI, graders): `seat8 login --from-env`
# AS_PASSWORD_IN=
# AS_PASSWORD_US=
